{
  "version": 10,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 28,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "base",
      "hidden": true,
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/${presetName}",
      "cacheVariables": {
        "CMAKE_EXPORT_COMPILE_COMMANDS": "ON",
        "BUILD_TESTING": "ON",
        "AEGIS_TARGET_MODE": "host_sim"
      }
    },
    {
      "name": "host-sim-debug",
      "inherits": "base",
      "displayName": "Host Simulation Debug",
      "description": "Host-native simulation debug build with assertions and test suite enabled",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "WARNINGS_AS_ERRORS": "ON"
      }
    },
    {
      "name": "host-sim-asan",
      "inherits": "base",
      "displayName": "Host Simulation ASan/UBSan",
      "description": "Host-native simulation with AddressSanitizer and UndefinedBehaviorSanitizer",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "ENABLE_SANITIZER_ADDRESS": "ON",
        "ENABLE_SANITIZER_UNDEFINED": "ON",
        "WARNINGS_AS_ERRORS": "ON"
      }
    },
    {
      "name": "host-release",
      "inherits": "base",
      "displayName": "Host Release",
      "description": "Optimized release build",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "BUILD_TESTING": "ON"
      }
    },
    {
      "name": "qemu-arm64",
      "inherits": "base",
      "displayName": "QEMU Virt ARM64 Emulation",
      "description": "Bare-metal ARM64 QEMU virt target configuration with hardware MMIO",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "AEGIS_TARGET_MODE": "qemu_virt"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "host-sim-debug",
      "configurePreset": "host-sim-debug",
      "displayName": "Build Host Simulation Debug"
    },
    {
      "name": "host-sim-asan",
      "configurePreset": "host-sim-asan",
      "displayName": "Build Host Simulation ASan"
    },
    {
      "name": "host-release",
      "configurePreset": "host-release",
      "displayName": "Build Host Release"
    },
    {
      "name": "qemu-arm64",
      "configurePreset": "qemu-arm64",
      "displayName": "Build QEMU ARM64 Target"
    }
  ],
  "testPresets": [
    {
      "name": "host-sim-debug",
      "configurePreset": "host-sim-debug",
      "displayName": "Test Host Simulation Debug",
      "output": {
        "outputOnFailure": true
      },
      "execution": {
        "noTestsAction": "error",
        "stopOnFailure": false
      }
    },
    {
      "name": "host-sim-asan",
      "configurePreset": "host-sim-asan",
      "displayName": "Test Host Simulation ASan",
      "output": {
        "outputOnFailure": true
      },
      "execution": {
        "noTestsAction": "error",
        "stopOnFailure": false
      }
    },
    {
      "name": "host-release",
      "configurePreset": "host-release",
      "displayName": "Test Host Release",
      "output": {
        "outputOnFailure": true
      },
      "execution": {
        "noTestsAction": "error",
        "stopOnFailure": false
      }
    },
    {
      "name": "qemu-arm64",
      "configurePreset": "qemu-arm64",
      "displayName": "Test QEMU ARM64 Emulation",
      "output": {
        "outputOnFailure": true
      },
      "execution": {
        "noTestsAction": "error",
        "stopOnFailure": false
      },
      "filter": {
        "include": {
          "name": "^qemu_smoke$"
        }
      }
    }
  ],
  "workflowPresets": [
    {
      "name": "host-sim-debug",
      "displayName": "Host Simulation Debug Workflow",
      "description": "Configure, build, and test host simulation debug pipeline",
      "steps": [
        {
          "type": "configure",
          "name": "host-sim-debug"
        },
        {
          "type": "build",
          "name": "host-sim-debug"
        },
        {
          "type": "test",
          "name": "host-sim-debug"
        }
      ]
    },
    {
      "name": "host-sim-asan",
      "displayName": "Host Simulation ASan Workflow",
      "description": "Configure, build, and test host simulation ASan pipeline",
      "steps": [
        {
          "type": "configure",
          "name": "host-sim-asan"
        },
        {
          "type": "build",
          "name": "host-sim-asan"
        },
        {
          "type": "test",
          "name": "host-sim-asan"
        }
      ]
    },
    {
      "name": "qemu-arm64",
      "displayName": "QEMU ARM64 Workflow",
      "description": "Configure, build, and test bare-metal ARM64 QEMU emulation pipeline",
      "steps": [
        {
          "type": "configure",
          "name": "qemu-arm64"
        },
        {
          "type": "build",
          "name": "qemu-arm64"
        },
        {
          "type": "test",
          "name": "qemu-arm64"
        }
      ]
    }
  ]
}
