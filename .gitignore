build/
Build/
build-*/
out/

# Compilation database and CMake caches (if generated for clangd/IDE)
compile_commands.json
CMakeFiles/
CMakeCache.txt
cmake_install.cmake
CMakeUserPresets.json
_deps/
.ninja_deps
.ninja_log
build.ninja
*.ninja

# Object files and dependency files
*.o
*.obj
*.lo
*.slo
*.d

# Compiled shared/static libraries and executables
*.so
*.so.*
*.dylib
*.dll
*.lai
*.la
*.a
*.lib
*.exe
*.out
*.app

