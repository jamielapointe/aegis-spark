# =============================================================================
# aegis-spark .gitignore (SPARK Ada 2022 + ISO C23 + Python 3.14.7)
# =============================================================================

# -----------------------------------------------------------------------------
# 1. Ada / SPARK / GNAT / GPRbuild / Alire Artifacts
# -----------------------------------------------------------------------------
# Alire local workspace state, host-specific binary lockfiles, and auto-config
# Note: alire/alire.lock pins host-OS/arch binary tarballs (e.g., aarch64-darwin
# vs x86_64-linux vs aarch64-linux), so it MUST be ignored across multi-OS hosts.
/alire/
alire/
/alire_install/
alire_install/
/config/
config/

# GPRbuild output directories
/obj/
obj/
/bin/
bin/
/lib/
lib/
/share/
share/

# GNATprove formal verification outputs & Why3 session caches
gnatprove/
**/gnatprove/
*.spark
gnatprove.out
why3session.xml
why3shapes.*
*.mlw
*.vcg

# GNAT compiler, binder, and callgraph intermediate artifacts
*.ali
*.adt
*.ci
*.cswi
*.bexch
*.lexch
*.deps
b__*.ads
b__*.adb
b__*.o
b__*.ali
b~*.ads
b~*.adb
b~*.o
b~*.ali

# Ada Language Server (ALS), GPRbuild, and GNAT Studio caches
.als/
.gpr_cache/
.gps/
auto.cgpr
default.cgpr
*.cgpr

# -----------------------------------------------------------------------------
# 2. Package Managers & Virtual Environments (Pixi / Python)
# -----------------------------------------------------------------------------
# Pixi environments & workspace directories
.pixi/
**/.pixi/
!.pixi/config.toml

# Standard Python virtual environments & local env files
.venv/
venv/
env/
ENV/
env.bak/
venv.bak/
.env
.env.*
.envrc
.python-version

# Legacy / alternative lockfiles (Pixi uses pixi.lock)
uv.lock
node_modules/

# -----------------------------------------------------------------------------
# 3. C23 / Clang / GCC / Linker / Sanitizer Artifacts
# -----------------------------------------------------------------------------
