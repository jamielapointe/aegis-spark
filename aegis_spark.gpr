with "aegis_spark_lib.gpr";
with "config/aegis_spark_config.gpr";

project Aegis_Spark is

   for Languages use ("Ada");
   for Source_Dirs use ("src/");
   for Source_Files use ("aegis_spark.adb");
   for Object_Dir use "obj/" & Aegis_Spark_Config.Build_Profile & "/demo";
   for Create_Missing_Dirs use "True";
   for Exec_Dir use "bin";
   for Main use ("aegis_spark.adb");

   package Compiler is
      for Default_Switches ("Ada") use
        Aegis_Spark_Config.Ada_Compiler_Switches &
        ("-gnatec=" & Aegis_Spark'Project_Dir & "gnat.adc",
         "-gnat2022",
         "-gnatW8",
         "-gnatwa",
         "-gnatwe",
         "-gnatw.X",
         "-gnatVa",
         "-gnata",
         "-gnaty3aAbBcefhiIklnOprStux",
         "-gnaty-d",
         "-gnatyM100",
         "-fcallgraph-info=su,da");
   end Compiler;

   package Binder is
      for Switches ("Ada") use ("-Es");
   end Binder;

   package Linker is
      case Aegis_Spark_Config.Alire_Host_OS is
         when "macos" =>
            for Switches ("Ada") use ("-Wl,-dead_strip");
         when others =>
            null;
      end case;
   end Linker;

   package Format is
      for Width ("Ada") use "100";
      for Indentation ("Ada") use "3";
   end Format;

end Aegis_Spark;
