with "aunit.gpr";
with "../../aegis_spark_lib.gpr";
with "../../config/aegis_spark_config.gpr";

project Aegis_Spark_Tests is

   for Languages use ("Ada");
   for Source_Dirs use ("src");
   for Object_Dir use "../../obj/" & Aegis_Spark_Config.Build_Profile & "/aunit";
   for Exec_Dir use "../../bin";
   for Main use ("aunit_runner.adb");

   package Compiler is
      for Default_Switches ("Ada") use
        Aegis_Spark_Config.Ada_Compiler_Switches &
        ("-gnatec=" & Aegis_Spark_Tests'Project_Dir & "gnat_test.adc",
         "-gnat2022",
         "-gnata",
         "-gnatyM100");
   end Compiler;

   package Binder is
      for Switches ("Ada") use ("-Es", "-t");
   end Binder;

   package Linker is
      case Aegis_Spark_Config.Alire_Host_OS is
         when "macos" =>
            for Switches ("Ada") use ("-Wl,-dead_strip");
         when others =>
            null;
      end case;
   end Linker;

end Aegis_Spark_Tests;
